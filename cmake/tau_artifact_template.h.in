// Generated by cmake/tau_bas.cmake from the artifact project template and the
// preset files — do not edit. `tau gen` compiles them into tau so it writes a
// buildable project with no SDK and no path of the emitting machine on disk;
// the exe-name placeholder inside the CMakeLists template stays literal for
// write_artifact_cmake to substitute.

#ifndef __IDNI__TAU__TAU_ARTIFACT_TEMPLATE_H__
#define __IDNI__TAU__TAU_ARTIFACT_TEMPLATE_H__

#include <string_view>

namespace idni::tau_lang {

inline constexpr std::string_view tau_artifact_cmake_template = R"TAU_TMPL(@TAU_ARTIFACT_CMAKE_TEMPLATE@)TAU_TMPL";

// The artifact CMakePresets.json: one visible preset per platform, no path of
// the emitting machine. Its include names the platforms.json beside it.
inline constexpr std::string_view tau_artifact_presets_json = R"TAU_TMPL(@TAU_ARTIFACT_PRESETS_JSON@)TAU_TMPL";

// platforms.json and every toolchain file it names, written beside the
// presets so the artifact's own CMakePresets.json resolves them.
inline constexpr std::string_view tau_platforms_json = R"TAU_TMPL(@TAU_PLATFORMS_JSON@)TAU_TMPL";
inline constexpr std::string_view tau_mingw_toolchain = R"TAU_TMPL(@TAU_MINGW_TOOLCHAIN@)TAU_TMPL";

// The map from a `./dev preset` name to the platform it builds in, and the
// platform names. `tau compile --preset X` maps X here before any SDK lookup,
// so an unknown name is an error with no SDK on disk; a platform name that is
// not a preset name maps to itself.
struct tau_platform_entry {
	std::string_view preset;
	std::string_view platform;
};

inline constexpr tau_platform_entry tau_preset_platform_map[] = {
@TAU_PRESET_PLATFORM_MAP_CPP@};

inline constexpr std::string_view tau_platform_names[] = {
@TAU_PLATFORM_NAMES_CPP@};

} // namespace idni::tau_lang

#endif // __IDNI__TAU__TAU_ARTIFACT_TEMPLATE_H__
