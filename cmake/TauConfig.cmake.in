@PACKAGE_INIT@

# Every dependency whose headers appear in the public tau.h closure is declared
# here. An installed tau-sdk bundles each one under this prefix, so the prefix
# goes first on the search path; a build-tree SDK leaves them to the caller,
# which the compile script supplies from the store this build resolved.
include(CMakeFindDependencyMacro)

if(EXISTS "${PACKAGE_PREFIX_DIR}/cmake/tauparserConfig.cmake")
	list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
endif()

# The parser SDK ships tauparser/... headers and ankerl/unordered_dense.h. The
# build links the alias name `tauparser`, so recreate it after the package is
# found, exactly as the Tau build does.
find_dependency(tauparser CONFIG)
if(NOT TARGET tauparser AND TARGET idni::tauparser_static)
	add_library(tauparser ALIAS idni::tauparser_static)
endif()

# Match the static Boost the library linked.
set(Boost_USE_STATIC_LIBS ON)
find_dependency(Boost COMPONENTS log)
if(MSVC)
	# MSVC autolink wants a tagged libboost_log_setup-vc143-...lib; the SDK's
	# Boost uses layout=system, so disable autolink and ask for the component.
	add_compile_definitions(BOOST_ALL_NO_LIB)
	find_dependency(Boost COMPONENTS log_setup)
endif()

# cvc5 is a dependency only when the pack this library was built for links it.
@TAU_SDK_FIND_CVC5@

# curl is a dependency only when the pack this library was built for links it.
@TAU_SDK_FIND_CURL@

include("${CMAKE_CURRENT_LIST_DIR}/TauTargets.cmake")

check_required_components(Tau)
