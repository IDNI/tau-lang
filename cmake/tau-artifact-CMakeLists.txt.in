# Generated by `tau gen` into the artifact directory. DO NOT EDIT BY HAND.
#
# The artifact is one translation unit linking the exported tau SDK. Every
# path, generated include dir and ABI-affecting definition it needs arrives
# through the TAU::TAU target, so this file carries no build, store or source
# path and the same project configures against any tau SDK.
cmake_minimum_required(VERSION 3.22.1 FATAL_ERROR)

# A wasm artifact needs the emsdk toolchain before project(), the same gate the
# tau CMakeLists uses. The SDK box is named by -DTau_DIR (the script always
# passes it) or by TAU_SDK_DIR, the directory holding TauConfig.cmake.
if(TAU_BUILD_EMSCRIPTEN)
	if(NOT Tau_DIR AND DEFINED ENV{TAU_SDK_DIR}
			AND NOT "$ENV{TAU_SDK_DIR}" STREQUAL "")
		set(Tau_DIR "$ENV{TAU_SDK_DIR}")
	endif()
	list(APPEND CMAKE_MODULE_PATH "${Tau_DIR}/cmake")
	include(tau-shared-emscripten)
	set_emscripten_toolchain()
endif()

project(tau_artifact CXX)

# The build type the caller resolved; a native compile defaults it to Release.
message(STATUS "tau artifact build type: ${CMAKE_BUILD_TYPE}")

# The box this artifact links: -DTau_DIR for a source-tree box, else the SDK
# box named by TAU_SDK_DIR. TAU_PLATFORM names the platform the box serves. No
# path of the machine that ran `tau gen` is baked in here.
set(TAU_PLATFORM "" CACHE STRING "Platform whose SDK box this artifact links")
find_package(Tau CONFIG REQUIRED HINTS $ENV{TAU_SDK_DIR})

set(TAU_ARTIFACT_EXE_NAME "@TAU_ARTIFACT_EXE_NAME@" CACHE STRING
	"artifact executable name")

add_executable(${TAU_ARTIFACT_EXE_NAME} main.cpp)
set_target_properties(${TAU_ARTIFACT_EXE_NAME} PROPERTIES
	CXX_STANDARD 23
	CXX_STANDARD_REQUIRED ON)
target_link_libraries(${TAU_ARTIFACT_EXE_NAME} PRIVATE TAU::TAU)
