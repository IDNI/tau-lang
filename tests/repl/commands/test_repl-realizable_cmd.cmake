# realizable command

include(add_repl_test)

# the realizable command checks if a Tau specification is realizable and
# prints T or F
add_repl_test(realizable_cmd-t "realizable T" ": T")
add_repl_test(realizable_cmd-f "realizable F" ": F")
add_repl_test(realizable_cmd-formula "realizable x = 0" ": T")

# realizable specs
add_repl_test(realizable_cmd-T         "realizable T"              ": T")
add_repl_test(realizable_cmd-wff_sat   "realizable X = 0"          ": T")
add_repl_test(realizable_cmd-wff_sat2  "realizable X != 0"         ": T")
add_repl_test(realizable_cmd-disjunct  "realizable X = 0 || Y = 0" ": T")

# unrealizable specs
add_repl_test(realizable_cmd-F             "realizable F"                ": F")
add_repl_test(realizable_cmd-contradiction "realizable X = 0 && X != 0"  ": F")

# temporal cases: a system can always force one of its own outputs, but
# it cannot force a value onto an input it merely reads
add_repl_test(realizable_cmd-output_eventually "realizable F (o1[t] = 0)"      ": T")
add_repl_test(realizable_cmd-input_eventually  "realizable F (i1[t] = 0)"      ": F")
add_repl_test(realizable_cmd-nested_temporal   "realizable G (F (o1[t] = 0))"  ": T")
add_repl_test(realizable_cmd-always_output     "realizable always (o1[t] = 0)" ": T")

# with rec-relation defs
add_repl_test(realizable_cmd-rr_pred "p(X) := X = 0. realizable p(t)" ": T")

# history references
add_repl_test(realizable_cmd-mem_rel  "T.   realizable %-0"  "T")
add_repl_test(realizable_cmd-mem_abs  "T.   realizable %1"   "T")
add_repl_test(realizable_cmd-mem_last "T.   realizable %"    "T")
add_repl_test(realizable_cmd-mem_F    "F.   realizable %"    "F")

