sat ((always o1[t]:tau = o1[t-1]:tau) && (sometimes o1[t]:tau = 1)).
sat ((always o1[t]:tau = 0) && (sometimes o1[t]:tau = 0) && (sometimes o1[t]:tau = 1)).
sat ((always o1[t-2]:tau = 1) && (sometimes o1[t-3]:tau = 0) && (sometimes o1[t]:tau = 1)).
sat ((always o1[t]:tau = i1[t]:tau) && (sometimes i1[t]:tau = 1)).
sat ((always i1[t]:tau = 1 ? o1[t]:tau = 0 : o1[t]:tau = 1)).
sat ((always o2[t]:tau = i1[t]:tau & i2[t]:tau) && (sometimes o2[t]:tau = 1)).
sat ((always o1[t]:tau = o1[t-1]:tau && o2[t]:tau = o2[t-1]:tau) || (sometimes o1[t]:tau = 1 && o2[t]:tau = 1)).
