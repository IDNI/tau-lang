sat ((always o2[t]:tau = i1[t]:tau & i2[t]:tau) && (sometimes o2[t]:tau = 1)) && ((always o4[t]:tau = i3[t]:tau & i4[t]:tau) && (sometimes o4[t]:tau = 1)).
