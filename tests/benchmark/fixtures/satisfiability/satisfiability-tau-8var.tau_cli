sat ((always o1[t]:tau = o1[t-1]:tau) && (sometimes o1[t]:tau = 1)) && ((always o3[t]:tau = o3[t-1]:tau) && (sometimes o3[t]:tau = 1)).
sat ((always o1[t]:tau = 0) && (sometimes o1[t]:tau = 0) && (sometimes o1[t]:tau = 1)) && ((always o3[t]:tau = 0) && (sometimes o3[t]:tau = 0) && (sometimes o3[t]:tau = 1)).
sat ((always o1[t-2]:tau = 1) && (sometimes o1[t-3]:tau = 0) && (sometimes o1[t]:tau = 1)) && ((always o3[t-2]:tau = 1) && (sometimes o3[t-3]:tau = 0) && (sometimes o3[t]:tau = 1)).
