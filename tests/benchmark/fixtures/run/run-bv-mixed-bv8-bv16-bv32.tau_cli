run always (o1[t]:bv[8] = i1[t]:bv[8] + { 1 }:bv[8] && o2[t]:bv[16] = i2[t]:bv[16] + { 1 }:bv[16] && o3[t]:bv[32] = i3[t]:bv[32] + { 1 }:bv[32]).
q
