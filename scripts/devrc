# Tau-root devrc shim.
#
# The shared dep_* function library (dep_entry, dep_var, dep_jobs, dep_ensure,
# ...) lives in the parser submodule. The store producers in scripts/dep/common
# source "${DEV_ROOT}/scripts/devrc" with DEV_ROOT at the Tau root, the same line
# the parser producers use. The shim does not change which devrc the helper
# hashes name: the parser's devrc sets __devrc_dir to its own directory.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../external/parser/scripts" && pwd)/devrc"
